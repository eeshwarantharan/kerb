{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eeshwarantharan/kerb/blob/main/src/platform/schema/query.findings.schema.json",
  "title": "kerb query findings",
  "description": "Cause findings, newest first, as KER `finding` records. Readers must ignore fields they don't know.",
  "type": "object",
  "required": [
    "query",
    "findings"
  ],
  "properties": {
    "query": {
      "const": "findings"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "kind",
          "test_id",
          "confidence"
        ],
        "properties": {
          "type": {
            "const": "finding"
          },
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "description": "milliseconds since the Unix epoch"
          },
          "kind": {
            "const": "cause"
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_id": {
            "type": "string"
          },
          "good_state": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^st_[0-9a-f]{16}$"
          },
          "bad_state": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^st_[0-9a-f]{16}$"
          },
          "culprit_hunks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hunk_count": {
            "type": "integer"
          },
          "probes": {
            "type": "integer"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "confirmed",
              "undetermined"
            ]
          },
          "reason_if_undetermined": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
